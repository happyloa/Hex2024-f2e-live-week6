{
  "name": "vivre",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm run build"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "nuxt-swiper": "^2.0.2"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-serif-tc": "^5.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.2.0"
  },
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@vercel/nft@1.11.1": {
      "glob": "14.0.4"
    },
    "readdir-glob@3.0.0": {
      "minimatch": "11.0.5"
    }
  }
}
