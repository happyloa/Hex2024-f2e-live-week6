{
  "name": "vivre",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "node scripts/apply-security-patches.mjs && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check:patches && npm run format:check && npm run typecheck && npm run build",
    "check:patches": "node scripts/apply-security-patches.mjs --check"
  },
  "dependencies": {
    "nuxt": "^4.6.0",
    "nuxt-swiper": "^2.0.2",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-serif-tc": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@nuxt/devtools@3.4.2": {
      "simple-git": "4.0.2"
    },
    "archiver-utils@5.0.2": {
      "glob": "13.0.6"
    },
    "braces": "3.0.3",
    "node-forge": "1.4.0"
  }
}
